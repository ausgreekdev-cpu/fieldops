{
  "name": "fieldops",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "supabase:start": "supabase start",
    "supabase:functions:serve": "supabase functions serve --env-file ./supabase/.env.local --debug",
    "build:web": "expo export --platform web --output-dir dist",
    "linux:docker:build": "docker build -f linux/Dockerfile -t fieldops:linux .",
    "linux:docker:run": "docker run -p 8080:80 fieldops:linux",
    "linux:package": "bash scripts/package-linux.sh",
    "linux:package:desktop": "bash scripts/package-desktop.sh",
    "desktop:build": "bash scripts/package-desktop.sh",
    "desktop:linux": "bash scripts/package-desktop.sh 0.1.0 --linux",
    "desktop:win": "bash scripts/package-desktop.sh 0.1.0 --win",
    "linux:install": "bash linux/install.sh",
    "linux:install:user": "bash linux/install.sh --user"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^11.3.1",
    "@react-pdf/renderer": "^4.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.60.0",
    "drizzle-orm": "^0.33.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-audio": "~0.3.0",
    "expo-background-fetch": "~13.0.1",
    "expo-camera": "~16.0.0",
    "expo-constants": "~17.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.11",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-task-manager": "~12.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-purchases": "^8.9.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.0.0",
    "react-native-signature-canvas": "^5.0.1",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "^13.12.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@types/react-native": "^0.72.8",
    "drizzle-kit": "^0.24.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/scripts/"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-purchases"
      ]
    }
  }
}
