# Copy to supabase/.env.local (never commit) and run:
# supabase secrets set OPENAI_API_KEY=sk-proj-... ANTHROPIC_API_KEY=sk-ant-... SUPABASE_SERVICE_ROLE_KEY=... STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_... REVENUECAT_WEBHOOK_SECRET=...

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
REVENUECAT_WEBHOOK_SECRET=...
AI_PROVIDER=openai

# For local Expo:
# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY in .env (publishable keys only)
